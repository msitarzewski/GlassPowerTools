<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Finder's toolbar button runs sandboxed. It reads the Finder's selection, which the Finder
	     hands it, and leaves requests for the app in its team-prefixed App Group (GPT_WIDGET_GROUP,
	     Config/Identity.xcconfig) — nothing else. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(GPT_WIDGET_GROUP)</string>
	</array>
</dict>
</plist>
