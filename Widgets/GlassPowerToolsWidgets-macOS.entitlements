<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A widget extension on the Mac runs sandboxed. It reads the app's snapshot from its own
	     team-prefixed App Group (GPT_WIDGET_GROUP, Config/Identity.xcconfig) and nothing else. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(GPT_WIDGET_GROUP)</string>
	</array>
</dict>
</plist>
