// Who signs this app and where it keeps what it shares. The one place a fork changes.
//
// To build under your own Apple Developer team, do not edit this file: create
// `Config/Identity.local.xcconfig` (git-ignored) and set the values you need there, for example
//
//     GPT_DEVELOPMENT_TEAM = ABCDE12345
//     GPT_BUNDLE_ID = com.example.glasspowertools
//     GPT_ICLOUD_CONTAINER = iCloud.com.example.glasspowertools
//     GPT_APP_GROUP = group.com.example.glasspowertools
//     GPT_KEYCHAIN_GROUP_SUFFIX = com.example.glasspowertools.shared
//     GPT_KVSTORE_SUFFIX = com.example.glasspowertools
//
// The entitlements files, the Info.plists and the code (`GlassAppIdentity`) all read these.
//
// The values below are this project's. The App Group, keychain group and key-value store carry the
// source applications' names (glas.sh, glassdb, glassDT) on purpose: they name stored data, and
// renaming them would orphan existing hosts and credentials.

GPT_DEVELOPMENT_TEAM = 7JQGQ7CRH8
GPT_BUNDLE_ID = com.glasspowertools
GPT_ICLOUD_CONTAINER = iCloud.com.glasspowertools
GPT_APP_GROUP = group.sh.glas.shared
GPT_KEYCHAIN_GROUP_SUFFIX = sh.glas.shared
GPT_KVSTORE_SUFFIX = sh.glas.app

// The widgets' snapshot (D68). On iPhone, iPad and Vision Pro it is in the App Group above. A Mac's
// widget extension runs sandboxed, and Xcode signs it with the team's wildcard profile, which cannot
// grant a `group.` App Group: the sandbox refused the snapshot and the Active widget read 0
// (2026-10-12). A team-prefixed group needs no profile on a Mac, so there it has one of its own.
GPT_WIDGET_GROUP = $(GPT_APP_GROUP)
GPT_WIDGET_GROUP[sdk=macosx*] = $(GPT_DEVELOPMENT_TEAM).$(GPT_BUNDLE_ID).widgets

// Push notifications (CloudKit change notices). `development` matches the development profiles
// that local builds are signed with; a distributed build must be `production`, which
// `Tools/Release/release-mac.sh` passes on its command line (D38).
GPT_APS_ENVIRONMENT = development

// Which of the container's two databases every build uses, Xcode's builds included. Production, the
// one released copies use: there are no users yet, so the owner's own library moved there before the
// first release (2026-10-18) rather than his devices and a released copy each seeing a different one.
// Development profiles allow either. A record type has to be deployed to production in CloudKit
// Console before a build can save it; `HostProfile` travels as one encoded field
// (`GlassCloudKitCatalogBackend`), so its changes need no deploy. A fork with its own container starts
// on Development, until its schema is deployed.
GPT_ICLOUD_ENVIRONMENT = Production

// Mac updates (D38, Sparkle). The feed lists releases; each update must be signed with the EdDSA
// private key whose public half is below. The key pair is made once with Sparkle's `generate_keys`
// and the private half stays in the maintainer's login Keychain. Empty, the build does not update
// itself — the right state for a fork, and for this project until the key exists.
GPT_SPARKLE_FEED_URL = https:/$()/glasspowertools.com/appcast.xml
GPT_SPARKLE_PUBLIC_KEY = 9We4jdfKY7j6hBL7Va2dAJJIR9Mip8/ZfTs95UtJXgU=

DEVELOPMENT_TEAM = $(GPT_DEVELOPMENT_TEAM)

#include? "Identity.local.xcconfig"
