<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SPIKE (D72 phase 5): a File Provider extension, sandboxed, that would read a machine's files over
	     SSH — so it needs the network, the team App Group, and the Keychain group the credentials live in.
	     Whether the Keychain group can be signed into a Mac extension at all is what step 2 measures. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(GPT_WIDGET_GROUP)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(GPT_KEYCHAIN_GROUP_SUFFIX)</string>
	</array>
</dict>
</plist>
