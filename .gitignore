.build/
DerivedData/
*.xcuserdatad/
xcuserdata/
.DS_Store
*.profraw
# Local Xcode/SwiftPM state. This repository builds from GlassPowerTools.xcodeproj,
# so the generated package workspace is never the project of record.
.swiftpm/

# Private working notes: readable by any local tool, never committed (projectRules rule 61).
.private/

# A fork's signing identity (see Config/Identity.xcconfig).
Config/Identity.local.xcconfig

# Agent session log: local working state, not project history (AGENTS.md).
.brain/

# The built website (Tools/Site/build_site.py).
_site/

# Live desktop probe output and device log archives: real machines' details, never tracked (rule 61).
Tests/LiveDesktop/*.txt
*.logarchive
